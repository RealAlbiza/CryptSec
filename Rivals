local function updateDeflection()
    local FC = getFighterController()
    if not FC or not FC.Objects then return end
    for _, obj in FC.Objects do
        local player = obj.Player
        if not player then continue end
        if not obj.Entity or not obj.Entity:IsAlive() or obj:Get("IsSpectating") then
            deflecting[player] = false
            continue

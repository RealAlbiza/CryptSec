local originalNames = {}
local originalStats = { Level = nil, Winstreak = nil }

local function spoofPlayer(player)
    if not originalNames[player] then
        originalNames[player] = { Name = player.Name, DisplayName = player.DisplayName }
    end
    if Toggles.NameSpoofToggle and Toggles.NameSpoofToggle.Value then
        local selfName  = Options.SpoofedSelfName  and Options.SpoofedSelfName.Value  or "Andy"
        local enemyName = Options.SpoofedEnemyName and Options.SpoofedEnemyName.Value or "Johnny"
        local name = (player == LocalPlayer) and selfName or enemyName
        pcall(function() player.Name = name; player.DisplayName = name end)
    else
        pcall(function() player.Name = originalNames[player].Name; player.DisplayName = originalNames[player].DisplayName end)
    end
end

local function spoofStats()
    local ls = LocalPlayer:FindFirstChild("CustomLeaderstats")
    if not ls then return end
    
    local lv = ls:FindFirstChild("Level")
    if lv and lv:IsA("IntValue") and originalStats.Level == nil then originalStats.Level = lv.Value end
    local ws = ls:FindFirstChild("Win Streak")
    local sv = ws and (ws:IsA("IntValue") and ws or (ws:IsA("Folder") and ws:FindFirstChildWhichIsA("IntValue")))
    if sv and originalStats.Winstreak == nil then originalStats.Winstreak = sv.Value end

    if Toggles.LevelSpoofToggle and Toggles.LevelSpoofToggle.Value then
        if lv and lv:IsA("IntValue") then lv.Value = Options.SpoofedLevel.Value end
        pcall(function() LocalPlayer:SetAttribute("Level", Options.SpoofedLevel.Value) end)
    elseif originalStats.Level ~= nil then
        if lv and lv:IsA("IntValue") then lv.Value = originalStats.Level end
        pcall(function() LocalPlayer:SetAttribute("Level", originalStats.Level) end)
    end
    
    if Toggles.WinstreakSpoofToggle and Toggles.WinstreakSpoofToggle.Value then
        if sv then sv.Value = Options.SpoofedWinstreak.Value end
        pcall(function() LocalPlayer:SetAttribute("StatisticDuelsWinStreak", Options.SpoofedWinstreak.Value) end)
    elseif originalStats.Winstreak ~= nil then
        if sv then sv.Value = originalStats.Winstreak end
        pcall(function() LocalPlayer:SetAttribute("StatisticDuelsWinStreak", originalStats.Winstreak) end)
    end
end


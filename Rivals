local rapidFireDone  = false
local savedCooldowns = {}

local function applyRapidFire()
    if rapidFireDone then return end
    local IL = getItemLibrary()
    if not IL then return end
    local ZERO = 1e-18
    local keys = { "ShootCooldown", "BurstCooldown", "AttackCooldown", "HeavyAttackCooldown" }
    local function scan(tbl)
        for _, v in pairs(tbl) do
            if type(v) == "table" then
                for _, k in keys do
                    if v[k] ~= nil then
                        if not savedCooldowns[v] then savedCooldowns[v] = {} end
                        if savedCooldowns[v][k] == nil then savedCooldowns[v][k] = v[k] end
                        v[k] = ZERO
                    end
                end
                scan(v)
            end
        end
    end
    scan(IL)
    rapidFireDone = true
end

local function restoreRapidFire()
    if not rapidFireDone then return end
    for tbl, keys in pairs(savedCooldowns) do
        for key, val in pairs(keys) do
            pcall(function() tbl[key] = val end)
        end
    end
    rapidFireDone = false
end

Toggles.RapidFireToggle:OnChanged(function()
    if Toggles.RapidFireToggle.Value then
        task.spawn(applyRapidFire)
    else
        restoreRapidFire()
    end
end)


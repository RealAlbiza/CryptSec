local function getClosestEntityInFOV()
    local center   = Camera.ViewportSize / 2
    local hitPart  = Options.SilentAimHitPart and Options.SilentAimHitPart.Value or "Head"
    local fovLimit = Options.SilentAimFOV and Options.SilentAimFOV.Value or 300
    local closest, closestDist = nil, fovLimit
    for _, entity in CollectionService:GetTagged("Entity") do
        if entity == LocalPlayer.Character then continue end
        local part = entity:FindFirstChild(hitPart, true)
        if not part or not part:IsA("BasePart") then continue end
        local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end
        local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if dist < closestDist then
            closestDist = dist
            closest = part
        end
    end
    return closest
end

local originalRaycast = nil
local raycastHooked   = false

local function installSilentAim()
    if raycastHooked then return end
    local util = getUtility()
    if not util or not util.Raycast then return end
    originalRaycast = util.Raycast
    util.Raycast = function(self, origin, dir, range, a, b, c)
        if not Toggles.SilentAimToggle.Value then
            return originalRaycast(self, origin, dir, range, a, b, c)
        end
        if type(range) ~= "number" or range < 100 then
            return originalRaycast(self, origin, dir, range, a, b, c)
        end
        local target = getClosestEntityInFOV()
        if not target then
            return originalRaycast(self, origin, dir, range, a, b, c)
        end
        local targetPos = target.Position
        local direction = (targetPos - origin).Unit
        local distance  = math.min((targetPos - origin).Magnitude, range)
        return {
            Position = targetPos,
            Distance = distance,
            Instance = target,
            Material = target.Material,
            Normal   = -direction,
        }
    end
    raycastHooked = true
end

local function uninstallSilentAim()
    if not raycastHooked then return end
    local util = getUtility()
    if util and originalRaycast then util.Raycast = originalRaycast end
    raycastHooked = false
end

Toggles.SilentAimToggle:OnChanged(function()
    if Toggles.SilentAimToggle.Value then task.spawn(installSilentAim)
    else uninstallSilentAim() end
end)


local emotesHooked      = false
local isLocalEmoting    = false
local localEmoteObject  = nil
local currentLocalEmote = nil
local runningConn       = nil
local prevCamMode, prevMinZoom = nil, nil
local hookedEntity, oldIsEmoting, oldGetCurrentEmote = nil, nil, nil

local function safeFire(signal)
    if not signal then return end
    if type(signal) == "table" then
        if type(signal.Fire) == "function" then pcall(signal.Fire, signal)
        elseif type(signal.fire) == "function" then pcall(signal.fire, signal) end
    elseif typeof(signal) == "Instance" and signal:IsA("BindableEvent") then
        pcall(function() signal:Fire() end)
    end
end

local function unhookEmoteEntity()
    if hookedEntity and oldIsEmoting then
        pcall(function() hookedEntity.IsEmoting = oldIsEmoting end)
    end
    if hookedEntity and oldGetCurrentEmote then
        pcall(function() hookedEntity.GetCurrentEmote = oldGetCurrentEmote end)
    end
    hookedEntity, oldIsEmoting, oldGetCurrentEmote = nil, nil, nil
end

local function stopLocalEmote()
    if not isLocalEmoting then return end
    isLocalEmoting = false
    localEmoteObject = nil
    pcall(function()
        if prevCamMode ~= nil then LocalPlayer.CameraMode = prevCamMode; prevCamMode = nil end
        if prevMinZoom ~= nil then LocalPlayer.CameraMinZoomDistance = prevMinZoom; prevMinZoom = nil end
    end)
    local FC = getFighterController()
    local fighter = FC and FC:GetFighter(LocalPlayer)
    local entity  = fighter and fighter.Entity
    if entity and entity.EmoteStatusChanged then safeFire(entity.EmoteStatusChanged) end
    if currentLocalEmote then
        pcall(function() currentLocalEmote:Destroy() end)
        currentLocalEmote = nil
    end
end

local function hookEmoteEntity(entity)
    if not entity or hookedEntity == entity then return end
    unhookEmoteEntity()
    hookedEntity       = entity
    oldIsEmoting       = entity.IsEmoting
    oldGetCurrentEmote = entity.GetCurrentEmote
    entity.IsEmoting = function(self, ...)
        if isLocalEmoting then return true end
        return oldIsEmoting(self, ...)
    end
    entity.GetCurrentEmote = function(self, ...)
        if isLocalEmoting and localEmoteObject then return localEmoteObject end
        return oldGetCurrentEmote(self, ...)
    end
end

local function setupHumanoidMonitor(char)
    if not char then return end
    local hum = char:WaitForChild("Humanoid", 10)
    if not hum then return end
    if runningConn then runningConn:Disconnect(); runningConn = nil end
    runningConn = hum.Running:Connect(function(speed)
        if speed > 0.1 and isLocalEmoting then stopLocalEmote() end
    end)
end

LocalPlayer.CharacterAdded:Connect(function(char)
    stopLocalEmote()
    setupHumanoidMonitor(char)
end)
setupHumanoidMonitor(LocalPlayer.Character)

Toggles.UnlockEmotesToggle:OnChanged(function()
    if not Toggles.UnlockEmotesToggle.Value then return end
    if emotesHooked then return end
    task.spawn(function()
        local CL  = getCosmeticLibrary()
        local EC  = getEmoteController()
        local PDC = getPlayerDataController()
        local FC  = getFighterController()
        if not CL or not EC then return end
        local Modules = repS:FindFirstChild("Modules")

        local oldOwnsCosmetic = CL.OwnsCosmetic
        CL.OwnsCosmetic = function(self, inventory, name)
            local cosmetic = CL.Cosmetics[name]
            if cosmetic and cosmetic.Type == "Emote" then return true end
            return oldOwnsCosmetic(self, inventory, name)
        end

        local _origCanEmote = EC.CanEmote
        EC.CanEmote = function(self, p2)
            local ok, res = pcall(_origCanEmote, self, p2)
            if ok and res then return true end
            if FC then
                local f = FC:GetFighter(LocalPlayer)
                if f and f.IsLocalPlayer and f:IsAlive() then
                    local e = f.Entity
                    if e and not e:Get("IsFrozen") then return true end
                end
            end
            return false
        end

        local oldUseEmoteByName = EC.UseEmoteByName
        EC.UseEmoteByName = function(self, emoteName)
            stopLocalEmote()
            local ownsIt = PDC and oldOwnsCosmetic(CL, PDC:Get("CosmeticInventory"), emoteName) or false
            pcall(function() oldUseEmoteByName(self, emoteName) end)
            if not ownsIt then
                task.spawn(function()
                    local folder = Modules and Modules:FindFirstChild("Emotes")
                    local mod    = folder and folder:FindFirstChild(emoteName)
                    local char   = LocalPlayer.Character
                    local hum    = char and char:FindFirstChildOfClass("Humanoid")
                    if mod and hum then
                        task.wait(0.1)
                        pcall(function()
                            currentLocalEmote = require(mod).new(hum)
                            prevCamMode  = LocalPlayer.CameraMode
                            prevMinZoom  = LocalPlayer.CameraMinZoomDistance
                            LocalPlayer.CameraMode = Enum.CameraMode.Classic
                            LocalPlayer.CameraMinZoomDistance = 8
                            isLocalEmoting   = true
                            localEmoteObject = currentLocalEmote
                            local entity
                            if FC then
                                local f = FC:GetFighter(LocalPlayer)
                                entity = f and f.IsLocalPlayer and f.Entity
                            end
                            if entity then
                                hookEmoteEntity(entity)
                                if entity.EmoteStatusChanged then safeFire(entity.EmoteStatusChanged) end
                            end
                            task.defer(currentLocalEmote.Simulate, currentLocalEmote)
                            currentLocalEmote.Destroying:Wait()
                            if isLocalEmoting then stopLocalEmote() end
                            unhookEmoteEntity()
                        end)
                    end
                end)
            end
        end
        emotesHooked = true
    end)
end)


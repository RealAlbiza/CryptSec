local TeleportBtn = Instance.new("TextButton")
TeleportBtn.Parent = Win2
TeleportBtn.BackgroundColor3 = Color3.fromRGB(50, 140, 80)
TeleportBtn.BorderSizePixel = 0
TeleportBtn.Position = UDim2.new(0, 10, 0, 68)
TeleportBtn.Size = UDim2.new(1, -20, 0, 30)
TeleportBtn.Font = Enum.Font.GothamBold
TeleportBtn.Text = "Teleport"
TeleportBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
TeleportBtn.TextSize = 13
Instance.new("UICorner", TeleportBtn).CornerRadius = UDim.new(0, 6)

TeleportBtn.MouseButton1Click:Connect(function()
    local text = InputBox.Text:gsub("%s+", "")
    local placeId = tonumber(text)

    if placeId and placeId > 0 then
        TeleportBtn.Text = "Teleporting..."
        local success, err = pcall(function()
            TeleportService:Teleport(placeId, LocalPlayer)
        end)
        if not success then
            TeleportBtn.Text = "Failed"
            warn("[Place Tools] Teleport failed:", err)
            task.wait(1.2)
            TeleportBtn.Text = "Teleport"
        end
    else
        TeleportBtn.Text = "Invalid ID"
        task.wait(0.9)
        TeleportBtn.Text = "Teleport"
    end
end)


-- Rage Bot state
local rageBotEnemyList  = {}
local rageBotIndex      = 1
local rageBotSwitchTime = 0
local RAGEBOT_INTERVAL  = 0.1  -- Seconds between enemy switch

RunService.RenderStepped:Connect(function()
    if not Toggles.RageBotToggle.Value then return end
    local mc     = getMatchController()
    local myChar = LocalPlayer.Character
    local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end

    -- Rebuild the living-enemy list every frame
    rageBotEnemyList = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = plr.Character
        if not char then continue end
        if char:GetAttribute("Dead") then continue end
        if char:GetAttribute("Health") and char:GetAttribute("Health") <= 0 then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        local isEnemy = mc and mc:IsPlayerEnemy(plr)
        if isEnemy == nil then isEnemy = true end
        if not isEnemy then continue end
        table.insert(rageBotEnemyList, hrp)
    end

    if #rageBotEnemyList == 0 then return end

    -- Clamp index in case enemies died/left
    if rageBotIndex > #rageBotEnemyList then
        rageBotIndex = 1
    end

    -- Cycle to the next enemy after the interval expires
    local now = tick()
    if now - rageBotSwitchTime >= RAGEBOT_INTERVAL then
        rageBotSwitchTime = now
        rageBotIndex = (rageBotIndex % #rageBotEnemyList) + 1
    end

    local targetHRP = rageBotEnemyList[rageBotIndex]
    if not targetHRP then return end

    -- Teleport to 2 studs directly behind the current target
    myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 2)

    -- Fire Kill Aura on ALL enemies every frame (independent of Kill Aura toggle)
    fireKillAura()
end)


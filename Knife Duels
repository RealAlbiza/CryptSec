-- os.clock / AttemptThrow hook (from src.lua)
local oldOsClock = nil
local hOk, hErr = pcall(function()
    oldOsClock = hookfunction(os.clock, function(...)
        if debug.info(debug.info(3, "f"), "n") == "AttemptThrow" then
            if Toggles.SilentAimToggle.Value and utility.target then
                local oldcf = Camera.CFrame
                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, utility.target.Position)
                local result = oldOsClock(...)
                task.defer(function()
                    RunService.RenderStepped:Wait()
                    Camera.CFrame = oldcf
                end)
                return result
            end
        end
        return oldOsClock(...)
    end)
end)
if not hOk then warn("[SilentAim] " .. tostring(hErr)) end


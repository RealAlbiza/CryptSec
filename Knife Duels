-- ======================== LAZY SERVICES ========================
-- pcall + WaitForChild so the UI always loads, even if the game isn't ready
local _MC, _RH

local function getMatchController()
    if _MC then return _MC end
    local ok, r = pcall(function()
        return require(
            LocalPlayer.PlayerScripts
                :WaitForChild("Controllers", 10)
                :WaitForChild("Match", 10)
                :WaitForChild("MatchController", 10)
        )
    end)
    if ok then _MC = r end
    return _MC
end

local function getReportHit()
    if _RH then return _RH end
    local ok, r = pcall(function()
        return game:GetService("ReplicatedStorage")
            :WaitForChild("CombatService", 10)
            :WaitForChild("RE", 10)
            :WaitForChild("ReportHit", 10)
    end)
    if ok then _RH = r end
    return _RH
end

-- ======================== SHARED UTILITY ========================
local utility = { target = nil }

local function isVisible(target)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character }
    params.IgnoreWater = true
    local origin = Camera.CFrame.Position
    local result = Workspace:Raycast(origin, target.Position - origin, params)
    if result then
        return Players:GetPlayerFromCharacter(result.Instance:FindFirstAncestorOfClass("Model")) ~= nil
    end
    return true
end

local function getClosestEnemy()
    local cam = Camera
    local center = cam.ViewportSize / 2
    local closestDist = math.huge
    local closestTarget = nil
    local mc = getMatchController()

    local useFov = Toggles.SilentUseFov and Toggles.SilentUseFov.Value
    local fovMax = (useFov and Options.SilentFovRadius) and Options.SilentFovRadius.Value or math.huge

    for _, v in pairs(Players:GetPlayers()) do
        if v == LocalPlayer then continue end
        local char = v.Character
        if not char then continue end
        if char:GetAttribute("Dead") then continue end
        if char:GetAttribute("Health") and char:GetAttribute("Health") <= 0 then continue end

        local hrp  = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        if not hrp or not head then continue end

        local isEnemy = mc and mc:IsPlayerEnemy(v)
        if isEnemy == nil then isEnemy = true end  -- default: everyone is enemy
        if not isEnemy then continue end

        -- Team check (only applied when SilentTeamCheck is on)
        if Toggles.SilentTeamCheck and Toggles.SilentTeamCheck.Value then
            if not (mc and mc:IsPlayerEnemy(v)) then continue end
        end

        local screenPos, onScreen = cam:WorldToViewportPoint(hrp.Position)
        if not onScreen then continue end

        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        if dist >= fovMax then continue end
        if dist >= closestDist then continue end

        -- Wall check (only applied when SilentWallCheck is on)
        if Toggles.SilentWallCheck and Toggles.SilentWallCheck.Value then
            if not isVisible(head) then continue end
        end

        closestDist   = dist
        closestTarget = head
    end
    return closestTarget
end


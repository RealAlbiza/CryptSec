local function updateESP()
    local mc = getMatchController()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if Toggles.ESPToggle.Value then
                local hl = espHighlights[player]
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.OutlineTransparency = 0
                    espHighlights[player] = hl
                end
                hl.Parent           = player.Character
                hl.FillTransparency = Options.ESPFillTransparency.Value
                local isEnemy = mc and mc:IsPlayerEnemy(player) or false
                local col = isEnemy and Options.ESPEnemyColor.Value or Options.ESPTeamColor.Value
                hl.FillColor    = col
                hl.OutlineColor = col
            else
                if espHighlights[player] then
                    espHighlights[player]:Destroy()
                    espHighlights[player] = nil
                end
            end
        end
    end
end

Players.PlayerRemoving:Connect(function(player)
    if espHighlights[player] then
        espHighlights[player]:Destroy()
        espHighlights[player] = nil
    end
end)

RunService.Heartbeat:Connect(function() pcall(updateESP) end)

